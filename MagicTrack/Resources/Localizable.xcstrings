      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        }
      }
    },
    "로그인 시 자동 시작": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open at Login"
