      }
    },
    "모두 내 기본값으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All to My Defaults"
          }
        }
      }
    },
    "모든 프리셋 초기화…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All Presets…"
          }
        }
      }
    },
    "모든 프리셋을 초기화할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset all presets?"
          }
        }
      }
    },
    "미분류": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "버전": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        }
      }
    },
    "버전 %@ (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version %@ (%@)"
          }
        }
      }
    },
    "버튼을 누른 뒤 원하는 조합을 누르세요. 글자 입력을 가로채지 않도록 ⌃ 또는 ⌘가 들어간 조합만 쓸 수 있어요. 취소는 esc.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the button, then press the combination you want. It must include ⌃ or ⌘ so it doesn’t interfere with typing. Press Esc to cancel."
          }
        }
      }
    },
    "변경": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change"
          }
        }
      }
    },
