          "stringUnit": {
            "state": "translated",
            "value": "Firm"
          }
        }
      }
    },
    "단축키 (자동 → 내장 고정 → 매직 고정)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcut (Auto → Built-in Only → Magic Only)"
