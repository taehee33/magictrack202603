    "마우스": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse"
          }
        }
      }
    },
    "마지막 전환 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last switched %@"
          }
        }
      }
    },
    "매직": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic"
          }
        }
      }
    },
    "매직 고정": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Only"
          }
        }
      }
    },
    "매직 트랙패드": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Magic Trackpad"
          }
        }
      }
    },
    "매직 트랙패드 또는 마우스를 블루투스로 연결한 뒤\n앱을 다시 열어주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a Magic Trackpad or mouse over Bluetooth,\nthen reopen the app."
          }
        }
      }
    },
    "매직 트랙패드 선택": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose Magic Trackpad"
          }
        }
      }
    },
    "매직 트랙패드 연결 없음": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Magic Trackpad connected"
          }
        }
      }
    },
    "매직 트랙패드를 돌려 놓고 쓸 때 방향을 맞춰요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match the direction when your Magic Trackpad is turned"
          }
        }
      }
    },
    "맥북 내장 트랙패드와 블루투스 매직 트랙패드의 감도를 개별적으로 조절합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the sensitivity of your MacBook’s built-in trackpad and your Magic Trackpad separately."
          }
        }
      }
    },
    "메뉴바에 사용 중인 트랙패드와 회전 표시": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show the trackpad in use and its rotation in the menu bar"
          }
        }
      }
    },
    "메뉴바에만 표시됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown in the menu bar only."
          }
        }
      }
    },
    "모두 Mac 기본값으로": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset All to Mac Defaults"
          }
