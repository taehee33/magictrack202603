// 이 파일을 같은 폴더에 Signing.local.xcconfig로 복사하고 아래 중 하나를 고른다 (git에 올라가지 않음).
// 어느 쪽이든 같은 인증서로 계속 서명하면 다시 빌드해도 손쉬운 사용 권한이 유지된다.
//
// 1) 자체 서명 인증서 (무료, 서명에 이메일·실명이 들어가지 않음) — 배포본은 이 방식
//    키체인 접근 › 인증서 지원 › 인증서 생성: 이름 'MagicMagicTrack', 신원 유형 '자체 서명 루트', 인증서 유형 '코드 서명'
CODE_SIGN_IDENTITY = MagicMagicTrack
DEVELOPMENT_TEAM =
// 자체 서명은 팀 ID가 없어서, Debug 빌드가 따로 만드는 미리보기용 dylib을 hardened runtime이 거부한다 → 만들지 않음
ENABLE_DEBUG_DYLIB = NO
//
// 2) Apple Development 인증서 (Xcode에 Apple ID 로그인). 서명에 Apple ID 이름(또는 이메일)이 들어간다
//    팀 ID: security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject 결과의 OU= 값
// CODE_SIGN_IDENTITY = Apple Development
// DEVELOPMENT_TEAM = YOUR_TEAM_ID
